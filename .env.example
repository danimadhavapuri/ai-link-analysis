# ==============================================================================
# AI-Powered Website Link Analysis API - Environment Configuration Template
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=4000
ENVIRONMENT=development
DEBUG=false

# LLM Configuration (Google Gemini)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
FALLBACK_MODEL=gemini-2.0-flash

# Website Extraction & Scraper Configuration
REQUEST_TIMEOUT=15.0
MAX_REDIRECTS=5
MAX_CONTENT_LENGTH=15000
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 (compatible; LinkAnalysisBot/1.0)

# In-Memory Cache Configuration (Cost & Performance Optimization)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ITEMS=256
